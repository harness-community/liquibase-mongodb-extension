<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd
        http://www.liquibase.org/xml/ns/mongodb http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <changeSet id="1" author="alex">
        <mongodb:createCollection collectionName="testCollection"/>
    </changeSet>

    <changeSet id="2" author="alex">
        <mongodb:createIndex collectionName="testCollection">
            <mongodb:keys>
                { userId: 1 }
            </mongodb:keys>
            <mongodb:options>
                { name: "userId_1" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="3" author="alex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <mongodb:mongoIndexExists collectionName="testCollection" indexName="userId_1"/>
            </not>
        </preConditions>

        <mongodb:createIndex collectionName="testCollection">
            <mongodb:keys>
                { userId: 1, type: 1 }
            </mongodb:keys>
            <mongodb:options>
                { name: "userId_1" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

</databaseChangeLog>

